{
  "name": "blog-agent-os",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de agentes autônomos que escrevem e publicam artigos de blog via OpenRouter",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env main.ts",
    "start": "tsx --env-file=.env main.ts",
    "check": "tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test \"tests/*_test.ts\"",
    "pacote": "powershell -ExecutionPolicy Bypass -File ./criar-pacote.ps1"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@openrouter/agent": "^0.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
