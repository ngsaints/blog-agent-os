# ===== Banco =====
# Com TURSO_DB_URL + TURSO_AUTH_TOKEN preenchidos, usa o Turso (nuvem).
# Se deixar vazio, o painel usa SQLite local (arquivo abaixo).
TURSO_DB_URL=
TURSO_AUTH_TOKEN=
# Arquivo do SQLite local (usado quando Turso não está configurado)
SQLITE_PATH=data/blog-agent.db

# ===== Painel administrativo =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opcional: segredo das sessões (default: ADMIN_PASSWORD)
# SESSION_SECRET=

# ===== Agendamento =====
# Frequência do loop do scheduler em minutos (execução local)
RUN_INTERVAL_MINUTES=15
# Token exigido no endpoint /__cron (use no cron do Deno Deploy)
CRON_TOKEN=

# ===== Servidor =====
PORT=8000

# ===== Configurado pelo painel (em /admin/settings) =====
# OPENROUTER_API_KEY, OPENROUTER_MODEL, OPENROUTER_IMAGE_MODEL,
# BLOG_API_BASE_URL e BLOG_API_TOKEN agora são salvos no banco,
# na tela "Configurações" do painel.